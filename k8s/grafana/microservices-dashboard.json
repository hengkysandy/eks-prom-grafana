{
  "dashboard": {
    "title": "Microservices HTTP Metrics",
    "tags": ["microservices", "http"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 0,
    "refresh": "5s",
    "panels": [
      {
        "id": 1,
        "title": "Request Rate by Service",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "targets": [{"expr": "sum(rate(http_requests_total[1m])) by (job)", "legendFormat": "{{job}}", "refId": "A"}],
        "fieldConfig": {"defaults": {"custom": {"drawStyle": "line", "fillOpacity": 10}, "unit": "reqps"}}
      },
      {
        "id": 2,
        "title": "Total Requests by Service",
        "type": "stat",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
        "targets": [{"expr": "sum(http_requests_total) by (job)", "legendFormat": "{{job}}", "refId": "A"}],
        "options": {"graphMode": "area", "colorMode": "value"}
      },
      {
        "id": 3,
        "title": "Service Health",
        "type": "stat",
        "gridPos": {"h": 4, "w": 24, "x": 0, "y": 8},
        "targets": [{"expr": "up{job=~\"nodejs-catalog|python-orders|go-inventory\"}", "legendFormat": "{{job}}", "refId": "A"}],
        "options": {"colorMode": "background", "graphMode": "none"},
        "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}}}, {"type": "value", "options": {"1": {"text": "UP", "color": "green"}}}], "thresholds": {"steps": [{"value": 0, "color": "red"}, {"value": 1, "color": "green"}]}}}
      },
      {
        "id": 10,
        "title": "Node.js - Requests per Endpoint",
        "type": "table",
        "gridPos": {"h": 8, "w": 8, "x": 0, "y": 12},
        "targets": [{"expr": "sum(http_requests_total{job=\"nodejs-catalog\"}) by (route, method, status)", "format": "table", "instant": true, "refId": "A"}],
        "transformations": [{"id": "organize", "options": {"excludeByName": {"Time": true, "job": true}, "renameByName": {"route": "Endpoint", "method": "Method", "status": "Status", "Value": "Total Requests"}}}]
      },
      {
        "id": 11,
        "title": "Python - Requests per Endpoint",
        "type": "table",
        "gridPos": {"h": 8, "w": 8, "x": 8, "y": 12},
        "targets": [{"expr": "sum(http_requests_total{job=\"python-orders\"}) by (endpoint, method, status)", "format": "table", "instant": true, "refId": "A"}],
        "transformations": [{"id": "organize", "options": {"excludeByName": {"Time": true, "job": true}, "renameByName": {"endpoint": "Endpoint", "method": "Method", "status": "Status", "Value": "Total Requests"}}}]
      },
      {
        "id": 12,
        "title": "Go - Requests per Endpoint",
        "type": "table",
        "gridPos": {"h": 8, "w": 8, "x": 16, "y": 12},
        "targets": [{"expr": "sum(http_requests_total{job=\"go-inventory\"}) by (route, method, status)", "format": "table", "instant": true, "refId": "A"}],
        "transformations": [{"id": "organize", "options": {"excludeByName": {"Time": true, "job": true}, "renameByName": {"route": "Endpoint", "method": "Method", "status": "Status", "Value": "Total Requests"}}}]
      },
      {
        "id": 4,
        "title": "Node.js - Request Rate by Endpoint",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 8, "x": 0, "y": 20},
        "targets": [{"expr": "sum(rate(http_requests_total{job=\"nodejs-catalog\"}[1m])) by (route)", "legendFormat": "{{route}}", "refId": "A"}],
        "fieldConfig": {"defaults": {"unit": "reqps"}}
      },
      {
        "id": 5,
        "title": "Python - Request Rate by Endpoint",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 8, "x": 8, "y": 20},
        "targets": [{"expr": "sum(rate(http_requests_total{job=\"python-orders\"}[1m])) by (endpoint)", "legendFormat": "{{endpoint}}", "refId": "A"}],
        "fieldConfig": {"defaults": {"unit": "reqps"}}
      },
      {
        "id": 6,
        "title": "Go - Request Rate by Endpoint",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 8, "x": 16, "y": 20},
        "targets": [{"expr": "sum(rate(http_requests_total{job=\"go-inventory\"}[1m])) by (route)", "legendFormat": "{{route}}", "refId": "A"}],
        "fieldConfig": {"defaults": {"unit": "reqps"}}
      },
      {
        "id": 7,
        "title": "Node.js - Status Codes",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 8, "x": 0, "y": 28},
        "targets": [{"expr": "sum(rate(http_requests_total{job=\"nodejs-catalog\"}[1m])) by (status)", "legendFormat": "{{status}}", "refId": "A"}]
      },
      {
        "id": 8,
        "title": "Python - Status Codes",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 8, "x": 8, "y": 28},
        "targets": [{"expr": "sum(rate(http_requests_total{job=\"python-orders\"}[1m])) by (status)", "legendFormat": "{{status}}", "refId": "A"}]
      },
      {
        "id": 9,
        "title": "Go - Status Codes",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 8, "x": 16, "y": 28},
        "targets": [{"expr": "sum(rate(http_requests_total{job=\"go-inventory\"}[1m])) by (status)", "legendFormat": "{{status}}", "refId": "A"}]
      },
      {
        "id": 13,
        "title": "Node.js - Response Time (p95 & p50)",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 8, "x": 0, "y": 36},
        "targets": [
          {"expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=\"nodejs-catalog\"}[1m])) by (le, route))", "legendFormat": "{{route}} p95", "refId": "A"},
          {"expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket{job=\"nodejs-catalog\"}[1m])) by (le, route))", "legendFormat": "{{route}} p50", "refId": "B"}
        ],
        "fieldConfig": {"defaults": {"unit": "s"}}
      },
      {
        "id": 14,
        "title": "Python - Response Time (p95 & p50)",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 8, "x": 8, "y": 36},
        "targets": [
          {"expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=\"python-orders\"}[1m])) by (le, endpoint))", "legendFormat": "{{endpoint}} p95", "refId": "A"},
          {"expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket{job=\"python-orders\"}[1m])) by (le, endpoint))", "legendFormat": "{{endpoint}} p50", "refId": "B"}
        ],
        "fieldConfig": {"defaults": {"unit": "s"}}
      },
      {
        "id": 15,
        "title": "Go - Response Time (p95 & p50)",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 8, "x": 16, "y": 36},
        "targets": [
          {"expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=\"go-inventory\"}[1m])) by (le, route))", "legendFormat": "{{route}} p95", "refId": "A"},
          {"expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket{job=\"go-inventory\"}[1m])) by (le, route))", "legendFormat": "{{route}} p50", "refId": "B"}
        ],
        "fieldConfig": {"defaults": {"unit": "s"}}
      },
      {
        "id": 16,
        "title": "Average Response Time by Service (p95)",
        "type": "stat",
        "gridPos": {"h": 6, "w": 24, "x": 0, "y": 44},
        "targets": [{"expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[1m])) by (le, job))", "legendFormat": "{{job}}", "refId": "A"}],
        "options": {"graphMode": "area", "colorMode": "value"},
        "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"steps": [{"value": 0, "color": "green"}, {"value": 0.1, "color": "yellow"}, {"value": 0.5, "color": "red"}]}}}
      }
    ]
  },
  "overwrite": true
}
