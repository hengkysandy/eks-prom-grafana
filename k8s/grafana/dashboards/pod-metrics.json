{
  "dashboard": {
    "title": "Pod & Container Metrics",
    "uid": "pod-metrics",
    "tags": ["kubernetes", "pods", "containers"],
    "timezone": "browser",
    "schemaVersion": 38,
    "refresh": "30s",
    "templating": {
      "list": [
        {
          "name": "namespace",
          "type": "query",
          "datasource": "Prometheus",
          "query": "label_values(kube_pod_info, namespace)",
          "refresh": 1,
          "includeAll": true,
          "multi": true,
          "current": {"text": "ecommerce-poc", "value": "ecommerce-poc"}
        },
        {
          "name": "pod",
          "type": "query",
          "datasource": "Prometheus",
          "query": "label_values(kube_pod_info{namespace=~\"$namespace\"}, pod)",
          "refresh": 1,
          "includeAll": true,
          "multi": true
        }
      ]
    },
    "panels": [
      {
        "id": 1,
        "title": "Pod Overview",
        "type": "row",
        "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0}
      },
      {
        "id": 2,
        "title": "Pod Status",
        "type": "table",
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 1},
        "targets": [
          {"expr": "kube_pod_status_phase{namespace=~\"$namespace\", pod=~\"$pod\"} == 1", "format": "table", "instant": true, "refId": "A"},
          {"expr": "kube_pod_container_status_restarts_total{namespace=~\"$namespace\", pod=~\"$pod\"}", "format": "table", "instant": true, "refId": "B"}
        ],
        "transformations": [
          {"id": "merge"},
          {"id": "organize", "options": {"excludeByName": {"Time": true, "__name__": true, "job": true, "instance": true, "uid": true}, "renameByName": {"namespace": "Namespace", "pod": "Pod", "phase": "Status", "Value #B": "Restarts"}}}
        ]
      },
      {
        "id": 3,
        "title": "CPU & Memory",
        "type": "row",
        "gridPos": {"h": 1, "w": 24, "x": 0, "y": 9}
      },
      {
        "id": 4,
        "title": "Pod CPU Usage",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 10},
        "targets": [{"expr": "sum(rate(container_cpu_usage_seconds_total{namespace=~\"$namespace\", pod=~\"$pod\", container!=\"\"}[5m])) by (pod)", "legendFormat": "{{pod}}", "refId": "A"}],
        "fieldConfig": {"defaults": {"unit": "short", "custom": {"fillOpacity": 20}}}
      },
      {
        "id": 5,
        "title": "Pod Memory Usage",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 10},
        "targets": [{"expr": "sum(container_memory_working_set_bytes{namespace=~\"$namespace\", pod=~\"$pod\", container!=\"\"}) by (pod)", "legendFormat": "{{pod}}", "refId": "A"}],
        "fieldConfig": {"defaults": {"unit": "bytes", "custom": {"fillOpacity": 20}}}
      },
      {
        "id": 6,
        "title": "CPU Usage vs Requests",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 18},
        "targets": [
          {"expr": "sum(rate(container_cpu_usage_seconds_total{namespace=~\"$namespace\", pod=~\"$pod\", container!=\"\"}[5m])) by (pod)", "legendFormat": "{{pod}} - Usage", "refId": "A"},
          {"expr": "sum(kube_pod_container_resource_requests{namespace=~\"$namespace\", pod=~\"$pod\", resource=\"cpu\"}) by (pod)", "legendFormat": "{{pod}} - Request", "refId": "B"}
        ],
        "fieldConfig": {"defaults": {"unit": "short"}}
      },
      {
        "id": 7,
        "title": "Memory Usage vs Requests",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 18},
        "targets": [
          {"expr": "sum(container_memory_working_set_bytes{namespace=~\"$namespace\", pod=~\"$pod\", container!=\"\"}) by (pod)", "legendFormat": "{{pod}} - Usage", "refId": "A"},
          {"expr": "sum(kube_pod_container_resource_requests{namespace=~\"$namespace\", pod=~\"$pod\", resource=\"memory\"}) by (pod)", "legendFormat": "{{pod}} - Request", "refId": "B"}
        ],
        "fieldConfig": {"defaults": {"unit": "bytes"}}
      },
      {
        "id": 8,
        "title": "Network & Restarts",
        "type": "row",
        "gridPos": {"h": 1, "w": 24, "x": 0, "y": 26}
      },
      {
        "id": 9,
        "title": "Network I/O",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 27},
        "targets": [
          {"expr": "sum(rate(container_network_receive_bytes_total{namespace=~\"$namespace\", pod=~\"$pod\"}[5m])) by (pod)", "legendFormat": "{{pod}} - RX", "refId": "A"},
          {"expr": "-sum(rate(container_network_transmit_bytes_total{namespace=~\"$namespace\", pod=~\"$pod\"}[5m])) by (pod)", "legendFormat": "{{pod}} - TX", "refId": "B"}
        ],
        "fieldConfig": {"defaults": {"unit": "Bps"}}
      },
      {
        "id": 10,
        "title": "Container Restarts",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 27},
        "targets": [{"expr": "increase(kube_pod_container_status_restarts_total{namespace=~\"$namespace\", pod=~\"$pod\"}[1h])", "legendFormat": "{{pod}}/{{container}}", "refId": "A"}],
        "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"steps": [{"value": null, "color": "green"}, {"value": 1, "color": "yellow"}, {"value": 5, "color": "red"}]}}}
      },
      {
        "id": 11,
        "title": "Request Metrics",
        "type": "row",
        "gridPos": {"h": 1, "w": 24, "x": 0, "y": 35}
      },
      {
        "id": 12,
        "title": "Request Rate by Pod",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 36},
        "targets": [{"expr": "sum(rate(http_requests_total{namespace=~\"$namespace\"}[5m])) by (pod)", "legendFormat": "{{pod}}", "refId": "A"}],
        "fieldConfig": {"defaults": {"unit": "reqps"}}
      },
      {
        "id": 13,
        "title": "Error Rate by Pod",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 36},
        "targets": [{"expr": "sum(rate(http_errors_total{namespace=~\"$namespace\"}[5m])) by (pod)", "legendFormat": "{{pod}}", "refId": "A"}],
        "fieldConfig": {"defaults": {"unit": "reqps", "color": {"mode": "palette-classic"}}}
      }
    ]
  },
  "overwrite": true
}
